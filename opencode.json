{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "__pycache__/**"]
  },
  "model": "openai/gpt-5.2-codex",
  "small_model": "openai/gpt-4o-mini",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "command": {
    "test": {
      "template": "Run the test suite and show only failing tests with their error messages.",
      "description": "Run tests efficiently",
      "model": "openai/gpt-4o-mini"
    },
    "lint": {
      "template": "Run linter and show only errors, not warnings. Fix any critical issues.",
      "description": "Quick lint check",
      "model": "openai/gpt-4o-mini"
    }
  }
}